{
  "name": "ami-claw",
  "displayName": "AmiClaw",
  "description": "AmiClaw - Local Ollama chat assistant for code generation and insertion.",
  "version": "0.0.1",
  "publisher": "localdev",
  "icon": "AmiClaw.png",
  "engines": { "vscode": "^1.90.0" },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -p . -w",
    "package": "node -e \"require('fs').mkdirSync('./dist',{recursive:true})\" && npx vsce package --out ./dist/ami-claw.vsix --no-dependencies"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.4.2",
    "@types/vscode": "^1.90.0",
    "vsce": "^2.12.0"
  },
  "dependencies": {},
  "activationEvents": ["onCommand:amiClaw.chat", "onCommand:amiClaw.sendToChat"],
  "contributes": {
    "commands": [
      {
        "command": "amiClaw.chat",
        "title": "AmiClaw"
      },
      {
        "command": "amiClaw.sendToChat",
        "title": "傳送到 AmiClaw"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "amiClaw.sendToChat",
          "group": "navigation@99"
        }
      ],
      "editor/context": [
        {
          "command": "amiClaw.sendToChat",
          "group": "navigation@99"
        }
      ]
    },
    "configuration": [
      {
        "id": "amiClaw",
        "title": "AmiClaw",
        "properties": {
          "amiClaw.url": {
            "type": "string",
            "default": "http://localhost:11434",
            "description": "Ollama server URL"
          },
          "amiClaw.model": {
            "type": "string",
            "default": "llama3",
            "description": "Ollama model name"
          },
          "amiClaw.models": {
            "type": "array",
            "items": { "type": "string" },
            "default": ["llama3", "llama2", "vicuna", "mistral"],
            "description": "Available model options shown in the chat UI"
          },
          "amiClaw.systemPrompt": {
            "type": "string",
            "editPresentation": "multilineText",
            "default": "你是一位資深頂尖全端軟體工程師，精通 TypeScript/JavaScript、Python、C/C++、Rust、Go、Shell/PowerShell、UEFI/BIOS 韌體工程。你邏輯嚴密、思路清晰，能直接找出問題根因並提供完整可執行的解法，不說廢話。請用繁體中文回答，技術術語附上英文原文。",
            "description": "AI 角色設定（System Prompt），每次對話都會自動套用。可在此自訂角色、背景知識與回答風格。"
          }
        }
      }
    ]
  }
}
