{
  "name": "ami-claw",
  "displayName": "AmiClaw",
  "description": "AmiClaw - Local Ollama chat assistant for code generation and insertion.",
  "author": "YCHsu",
  "license": "MIT",
  "version": "0.0.1",
  "publisher": "localdev",
  "icon": "AmiClaw.png",
  "engines": { "vscode": "^1.90.0" },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -p . -w",
    "package": "node -e \"require('fs').mkdirSync('./dist',{recursive:true})\" && npx vsce package --out ./dist/ami-claw.vsix --no-dependencies"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.4.2",
    "@types/vscode": "^1.90.0",
    "vsce": "^2.12.0"
  },
  "dependencies": {},
  "activationEvents": ["onCommand:amiClaw.chat", "onCommand:amiClaw.sendToChat", "onView:amiClaw.openChat"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "amiClaw",
          "title": "AmiClaw",
          "icon": "media/ami-claw-activity.svg"
        }
      ]
    },
    "views": {
      "amiClaw": [
        {
          "id": "amiClaw.openChat",
          "name": "聊天記錄"
        }
      ]
    },
    "commands": [
      {
        "command": "amiClaw.chat",
        "title": "AmiClaw"
      },
      {
        "command": "amiClaw.sendToChat",
        "title": "傳送到 AmiClaw"
      },
      {
        "command": "amiClaw.newChatSession",
        "title": "新增聊天",
        "icon": "$(add)"
      },
      {
        "command": "amiClaw.switchChatSession",
        "title": "切換到此聊天"
      },
      {
        "command": "amiClaw.renameChatSession",
        "title": "重新命名"
      },
      {
        "command": "amiClaw.deleteChatSession",
        "title": "刪除聊天"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "amiClaw.sendToChat",
          "group": "navigation@99"
        }
      ],
      "editor/context": [
        {
          "command": "amiClaw.sendToChat",
          "group": "navigation@99"
        }
      ],
      "view/title": [
        {
          "command": "amiClaw.newChatSession",
          "when": "view == amiClaw.openChat",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "amiClaw.renameChatSession",
          "when": "view == amiClaw.openChat && viewItem == chatSession",
          "group": "1_modify@1"
        },
        {
          "command": "amiClaw.deleteChatSession",
          "when": "view == amiClaw.openChat && viewItem == chatSession",
          "group": "1_modify@2"
        }
      ]
    },
    "configuration": [
      {
        "id": "amiClaw",
        "title": "AmiClaw",
        "properties": {
          "amiClaw.url": {
            "type": "string",
            "default": "http://localhost:11434",
            "description": "Ollama server URL（單一伺服器時使用；多伺服器請改用 amiClaw.urls）"
          },
          "amiClaw.urls": {
            "type": "array",
            "items": { "type": "string" },
            "default": [],
            "description": "多台 Ollama 伺服器 URL 列表，例如 [\"http://localhost:11434\", \"http://192.168.1.100:11434\"]。設定後將優先取代 amiClaw.url。"
          },
          "amiClaw.model": {
            "type": "string",
            "default": "llama3",
            "description": "Ollama model name"
          },
          "amiClaw.models": {
            "type": "array",
            "items": { "type": "string" },
            "default": ["llama3", "llama2", "vicuna", "mistral"],
            "description": "Available model options shown in the chat UI"
          },
          "amiClaw.systemPrompt": {
            "type": "string",
            "editPresentation": "multilineText",
            "default": "你是一位資深頂尖全端軟體工程師，精通 TypeScript/JavaScript、Python、C/C++、Rust、Go、Shell/PowerShell、UEFI/BIOS 韌體工程。你邏輯嚴密、思路清晰，能直接找出問題根因並提供完整可執行的解法，不說廢話。請用繁體中文回答，技術術語附上英文原文。",
            "description": "AI 角色設定（System Prompt），每次對話都會自動套用。可在此自訂角色、背景知識與回答風格。"
          },
          "amiClaw.jiraBaseUrl": {
            "type": "string",
            "default": "",
            "description": "（選填）Jira server base URL，例如 https://yourcompany.atlassian.net。若已安裝 atlassian.atlascode 並登入，系統會自動取得，無需手動設定。僅在無 atlascode 時作為 fallback。"
          },
          "amiClaw.jiraEmail": {
            "type": "string",
            "default": "",
            "description": "（選填）Jira 登入 Email（Jira Cloud Basic Auth fallback 用）。已安裝 atlascode 時不需要設定。"
          },
          "amiClaw.jiraPat": {
            "type": "string",
            "default": "",
            "description": "（選填）Jira API Token（Cloud）或 Personal Access Token（Server/DC）。已安裝 atlascode 時不需要設定。"
          }
        }
      }
    ]
  }
}
